<Window x:Class="DiabloBuildAdvisor.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="庇护所配装助手" Width="1260" Height="800" MinWidth="1040" MinHeight="680" WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#0F1013" BorderBrush="#24252A" BorderThickness="0,0,1,0">
      <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="DIABLO IV" Foreground="{StaticResource GoldBrush}" FontSize="12" FontWeight="Bold"/><TextBlock Text="庇护所配装助手" FontSize="21" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel>
        <StackPanel Grid.Row="2"><TextBlock Text="01  BUILD 概览" Margin="0,14" Foreground="{StaticResource GoldBrush}"/><TextBlock Text="02  属性诊断" Margin="0,14" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="03  装备对比" Margin="0,14" Foreground="{StaticResource MutedBrush}"/><Border Height="1" Background="#2A2B30" Margin="0,18"/><TextBlock Text="支持来源" Foreground="{StaticResource MutedBrush}" FontSize="12"/><TextBlock Text="Maxroll · Mobalytics&#x0a;D4Builds · 通用 JSON" Margin="0,8" LineHeight="24"/></StackPanel>
        <TextBlock Grid.Row="3" Text="本地优先 · 不上传 Build 文件" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
      </Grid>
    </Border>
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="34,26,34,38">
      <Grid><StackPanel><TextBlock Text="BUILD 控制台" FontSize="13" Foreground="{StaticResource GoldBrush}" FontWeight="Bold"/><TextBlock Text="看清每一条词缀的真实价值" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#183128" CornerRadius="14" Padding="12,6"><TextBlock x:Name="StatusText" Text="●  等待导入" Foreground="#74D69E" FontSize="12"/></Border></Grid>
      <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="20" Margin="0,24,0,18" BorderBrush="#292A2E" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="从文件或分享链接开始" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="JSON 在本机解析；链接导入会读取公开页面数据，不需要登录。" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/><TextBox x:Name="UrlBox" Margin="0,14,18,0" MinWidth="480" ToolTip="粘贴 Maxroll / Mobalytics / D4Builds 链接"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Bottom" Orientation="Horizontal"><Button Content="导入 JSON" Click="ImportJson_Click"/><Button Content="读取链接" Background="#303138" Foreground="White" Click="ImportLink_Click"/><Button Content="设为目标" Background="#303138" Foreground="White" Click="SetTarget_Click"/></StackPanel></Grid></Border>
      <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Background="{StaticResource PanelBrush}" CornerRadius="7" Padding="16" Margin="0,0,8,0"><StackPanel><TextBlock Text="武器伤害" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="WeaponText" Text="—" FontSize="23" Margin="0,6,0,0"/></StackPanel></Border>
        <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="7" Padding="16" Margin="8,0"><StackPanel><TextBlock Text="主属性" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="MainStatText" Text="—" FontSize="23" Margin="0,6,0,0"/></StackPanel></Border>
        <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="7" Padding="16" Margin="8,0"><StackPanel><TextBlock Text="加法伤害池" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="AdditiveText" Text="—" FontSize="23" Margin="0,6,0,0"/></StackPanel></Border>
        <Border Grid.Column="3" Background="{StaticResource PanelBrush}" CornerRadius="7" Padding="16" Margin="8,0,0,0"><StackPanel><TextBlock Text="暴击 / 爆伤" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="CritText" Text="—" FontSize="23" Margin="0,6,0,0"/></StackPanel></Border>
      </Grid>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width=".9*"/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions>
        <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="20" Margin="0,0,9,0"><StackPanel><TextBlock Text="配装诊断" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="BuildNameText" Text="导入 Build 后生成建议" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,16"/><ItemsControl x:Name="SuggestionsList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#1B1C21" CornerRadius="6" Padding="14" Margin="0,0,0,10" BorderBrush="{Binding Accent}" BorderThickness="3,0,0,0"><StackPanel><TextBlock Text="{Binding Severity}" Foreground="{Binding Accent}" FontSize="11" FontWeight="Bold"/><TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,4"/><TextBlock Text="{Binding Message}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="20"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
        <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="20" Margin="9,0,0,0"><StackPanel>
          <TextBlock Text="当前装备" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="GearCountText" Text="导入后将在这里显示装备清单" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,12"/>
          <DataGrid x:Name="CurrentGearGrid" Height="300" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="部位" Binding="{Binding Slot}" Width="90"/><DataGridTextColumn Header="装备" Binding="{Binding Name}" Width="1.2*"/><DataGridTextColumn Header="威能" Binding="{Binding Aspect}" Width="90"/><DataGridTextColumn Header="词条" Binding="{Binding AffixSummary}" Width="1.6*"/></DataGrid.Columns></DataGrid>
          <Border Height="1" Background="#2A2B30" Margin="0,18,0,14"/>
          <TextBlock Text="目标 Build 差距" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="TargetText" Text="先导入毕业 Build 并点击“设为目标”，再导入当前 Build" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,12"/>
          <DataGrid x:Name="ComparisonGrid" Height="230" IsReadOnly="True" Visibility="Collapsed"><DataGrid.Columns><DataGridTextColumn Header="部位" Binding="{Binding Slot}" Width="70"/><DataGridTextColumn Header="当前" Binding="{Binding Current}" Width="*"/><DataGridTextColumn Header="目标" Binding="{Binding Target}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="75"/><DataGridTextColumn Header="差距" Binding="{Binding Detail}" Width="1.5*"/></DataGrid.Columns></DataGrid>
        </StackPanel></Border>
      </Grid>
      <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="20" Margin="0,18,0,0" BorderBrush="#292A2E" BorderThickness="1">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,18,0"><TextBlock Text="游戏红点覆盖提示" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="打开游戏技能树或对应巅峰盘，保持 100% 缩放，然后进行两点校准。覆盖层不会自动点击游戏。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,14" LineHeight="20"/>
            <WrapPanel><Button Content="校准技能树" Click="StartSkillOverlay_Click"/><Button Content="校准巅峰盘" Click="StartParagonOverlay_Click" Background="#303138" Foreground="White"/><Button Content="关闭红点" Click="CloseOverlay_Click" Background="#303138" Foreground="White"/></WrapPanel>
            <TextBlock Text="快捷键：F8 显示/隐藏 · F9 下一步 · Shift+F9 上一步" Foreground="{StaticResource GoldBrush}" Margin="0,13,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1"><TextBlock Text="导入的路线" FontWeight="SemiBold"/><TextBlock x:Name="RouteSummaryText" Text="尚未导入技能与巅峰数据" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,10"/>
            <ComboBox x:Name="ParagonBoardBox" DisplayMemberPath="Display" Background="#202126" Foreground="White" Padding="8" Margin="0,0,0,8"/>
            <ListBox x:Name="RouteStepsList" Height="115" Background="#17181C" Foreground="White" BorderThickness="0" DisplayMemberPath="Display"/>
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel></ScrollViewer>
  </Grid>
</Window>
